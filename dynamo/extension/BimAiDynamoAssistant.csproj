<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BimAiDynamoAssistant</AssemblyName>
    <RootNamespace>BimAiDynamoAssistant</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DynamoCore">
      <HintPath>$(DynamoRoot)\DynamoCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DynamoCoreWpf">
      <HintPath>$(DynamoRoot)\DynamoCoreWpf.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
