  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\nclr.AddReference(\"RevitServices\")\nfrom RevitServices.Persistence import DocumentManager\n\nuiapp = DocumentManager.Instance.CurrentUIApplication\nuidoc = uiapp.ActiveUIDocument if uiapp is not None else None\nif uidoc is None:\n    OUT = {\n        \"status\": \"no_active_document\",\n        \"view_name\": None,\n        \"view_type\": None,\n        \"selection_count\": 0,\n        \"selected_elements\": [],\n    }\nelse:\n    doc = uidoc.Document\n    view = uidoc.ActiveView\n    elements = []\n    for element_id in uidoc.Selection.GetElementIds():\n        element = doc.GetElement(element_id)\n        if element is not None:\n            category = element.Category.Name if element.Category is not None else None\n            elements.append({\"id\": str(element.Id.Value), \"category\": category})\n    OUT = {\n        \"status\": \"ok\",\n        \"view_name\": view.Name,\n        \"view_type\": str(view.ViewType),\n        \"selection_count\": len(elements),\n        \"selected_elements\": elements,\n    }\n",
      "Engine": "PythonNet3",
      "EngineName": "PythonNet3",
      "VariableInputPorts": false,
