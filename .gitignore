# Secrets and local configuration
.env
.env.*
!.env.example

# Revit models and generated output
*.rvt
*.rfa
*.rte
*.ifc
*.nwc
*.nwd

# Generated routines stay local until reviewed and explicitly promoted.
# Already tracked examples remain tracked; use git add -f only after validation.
routines/*.py
routines/*.dyn
routines/*.manifest.json

# Local logs
logs/*.log
logs/*.jsonl
logs/runner-results/
logs/attachments/**
logs/materials/**
*.log
*.tmp
*.temp
*.bak
.DS_Store
Thumbs.db

# Build output
bin/
obj/
publish/
artifacts/
docs/assets/asistente-bim-preview.png

# Large third-party installer is fetched from its pinned official release.
vendor/*.zip

# Python/Node tooling caches
__pycache__/
*.py[cod]
node_modules/

# Per-clone Codex MCP wiring is generated by setup.ps1 with machine-specific paths.
.codex/
# Local model profile, conversation history, catalogs, and user-specific preferences stay on each PC.
.arq-ia/
revit/test-models/**/*.slog
revit/test-models/**/*.dat
revit/test-models/**/*.zip
